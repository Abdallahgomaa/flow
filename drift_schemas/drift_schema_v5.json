      ]
    },
    {
      "name": "audit_log",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"audit_log\" (\"seq\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"occurred_at\" INTEGER NOT NULL, \"actor\" TEXT NULL, \"action\" TEXT NOT NULL, \"entity\" TEXT NOT NULL, \"entity_id\" TEXT NULL, \"payload\" TEXT NOT NULL, \"prev_hash\" TEXT NOT NULL, \"hash\" TEXT NOT NULL);"
        }
      ]
    },
    {
      "name": "audit_checkpoints",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"audit_checkpoints\" (\"seq\" INTEGER NOT NULL, \"hash\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"seq\"));"
        }
      ]
    },
    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"id\" TEXT NOT NULL, \"parent_id\" TEXT NULL REFERENCES categories (id), \"name\" TEXT NOT NULL, \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"disabled_at\" INTEGER NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "roles",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"roles\" (\"code\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"description\" TEXT NULL, \"is_built_in\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_built_in\" IN (0, 1)), \"disabled_at\" INTEGER NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NULL, PRIMARY KEY (\"code\"));"
        }
      ]
    },
    {
      "name": "units",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"units\" (\"code\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"base_unit_code\" TEXT NULL REFERENCES units (code), \"factor_thousandths\" INTEGER NULL, \"disabled_at\" INTEGER NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NULL, PRIMARY KEY (\"code\"));"
        }
      ]
    },
    {
      "name": "users",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"users\" (\"id\" TEXT NOT NULL, \"username\" TEXT NOT NULL UNIQUE, \"display_name\" TEXT NOT NULL, \"role_code\" TEXT NOT NULL REFERENCES roles (code), \"password_hash\" TEXT NULL, \"pin_hash\" TEXT NULL, \"disabled_at\" INTEGER NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    }
